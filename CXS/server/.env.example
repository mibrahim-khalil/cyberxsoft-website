PORT=5000
CLIENT_URL=http://localhost:5173

# MongoDB (unchanged — keep the value you already use on the server)
# MONGODB_URI=

# ---------------------------------------------------------
# Contact-form email (new)
# ---------------------------------------------------------
# Any SMTP provider works. Ask your mail host for these values.
SMTP_HOST=mail.example.com
# 465 = implicit TLS (SMTP_SECURE=true).  587 = STARTTLS (SMTP_SECURE=false).
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@cyberxsoft.net
SMTP_PASS=change-me

# Shown as the sender. Use an address on your own domain so it is not marked as spam.
MAIL_FROM="CyberX Soft <info@cyberxsoft.net>"

# Who receives each new enquiry (comma-separated for several people).
CONTACT_TO=info@cyberxsoft.net

# Send the visitor a short acknowledgement email too (true / false).
CONTACT_AUTOREPLY=true

# Optional
# SMTP_REQUIRE_TLS=false
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Set to 1 when the API runs behind a reverse proxy (nginx, load balancer)
# so rate limiting sees each visitor's real IP.
# TRUST_PROXY=1
