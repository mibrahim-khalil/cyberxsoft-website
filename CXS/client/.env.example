# Read at BUILD time by Vite. Rebuild after changing these.

# Public https address of the API, no trailing slash.
# Local development: http://localhost:5000
# Production example: https://api.cyberxsoft.net
VITE_API_URL=http://localhost:5000

# Final public address of the website. Adds canonical links and absolute
# share (og) URLs. Leave empty for local development.
VITE_SITE_URL=
